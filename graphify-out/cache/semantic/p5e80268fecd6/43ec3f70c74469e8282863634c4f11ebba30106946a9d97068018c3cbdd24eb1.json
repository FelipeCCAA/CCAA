{"nodes": [{"id": "prototipo_modelo_datos", "label": "MODELO_DATOS.md", "file_type": "document", "source_file": "prototipo/MODELO_DATOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "prototipo_modelo_datos", "label": "Modelo de Datos \u2014 Prototipo CCAA", "file_type": "document", "source_file": "prototipo/MODELO_DATOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El c\u00f3digo de lote no es la identidad del lote porque en los datos reales un mismo c\u00f3digo se repite para productos distintos; la identidad la asigna el sistema y la clave natural es codigoLote+productoId+fecha."}, {"id": "concept_modelo_datos_lote", "label": "lote (entidad prototipo)", "file_type": "concept", "source_file": "prototipo/MODELO_DATOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unidad de producci\u00f3n y de liberaci\u00f3n; la clave natural controlada como \u00fanica es codigoLote+productoId+fecha, no el c\u00f3digo de lote solo."}, {"id": "concept_modelo_datos_liberacion", "label": "liberacion / puedeLiberar() (entidad prototipo)", "file_type": "concept", "source_file": "prototipo/MODELO_DATOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "puedeLiberar() y puedeDespachar() devuelven {permitido, bloqueos[]} para que la interfaz explique por qu\u00e9 no se puede avanzar, no solo un booleano."}, {"id": "concept_modelo_datos_especificacion", "label": "especificacion versionada (entidad prototipo)", "file_type": "concept", "source_file": "prototipo/MODELO_DATOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un lote de mayo se audita contra la especificaci\u00f3n vigente en mayo, no la actual; sin esto