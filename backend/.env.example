# Configuracion local. Copiar a backend/.env y ajustar.
#
# .env NO se versiona: cada equipo tiene el suyo. Este archivo es la lista de
# variables que el proyecto lee, con valores de ejemplo listos para produccion.
# Para desarrollo, lo habitual es dejar DJANGO_DEBUG=true y no tocar el resto.


# --- Django ----------------------------------------------------------------

DJANGO_ENV=production
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.tudominio.cl
CORS_ALLOWED_ORIGINS=https://app.tudominio.cl
CSRF_TRUSTED_ORIGINS=https://app.tudominio.cl
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=false


# --- Base de datos ---------------------------------------------------------
#
# El proyecto corre sobre PostgreSQL. El motivo esta en DECISIONES.md; el
# corto es que en SQLite solo escribe uno a la vez y el bloqueo de filas no
# existe, asi que la firma de una liberacion no se puede proteger de una
# modificacion concurrente.

# En Vercel + Neon basta con DATABASE_URL; la integracion la crea de forma
# automatica. En otros proveedores puedes copiar aqui su URL de conexion.
# DATABASE_URL=postgresql://usuario:clave@servidor/ccaa?sslmode=require

# Alternativa: variables separadas para instalaciones sin DATABASE_URL.
DB_NAME=ccaa
DB_USER=ccaa
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

# Organización inicial requerida únicamente al instalar una base vacía.
CCAA_INITIAL_COMPANY_RUT=RUT-REAL-DE-LA-EMPRESA
CCAA_INITIAL_COMPANY_NAME=Campos Australes

# DB_ENGINE solo se conserva para detectar configuraciones antiguas. El único
# valor aceptado es postgresql; SQLite ya no es un fallback soportado.
DB_ENGINE=postgresql


# --- Recuperacion de contrasena --------------------------------------------

PASSWORD_RESET_FRONTEND_URL=https://app.tudominio.cl/#/restablecer-contrasena
PASSWORD_RESET_TIMEOUT=3600
DEFAULT_FROM_EMAIL=sistema-produccion@tudominio.cl


# --- Envio de correo por Microsoft Graph ------------------------------------
#
# Sin almacenar la contrasena personal de nadie: se registra una aplicacion en
# Entra con permiso Mail.Send de aplicacion. Conviene restringirla al buzon
# remitente con RBAC de Exchange, porque ese permiso alcanza a toda la
# organizacion si no se limita. El detalle esta en el README.

EMAIL_BACKEND=usuarios.email_backends.MicrosoftGraphEmailBackend
MICROSOFT_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_SECRET=reemplazar-en-el-entorno-seguro
MICROSOFT_GRAPH_SENDER=sistema-produccion@tudominio.cl
MICROSOFT_GRAPH_TIMEOUT=15
MICROSOFT_GRAPH_SAVE_TO_SENT_ITEMS=false


# --- Limites de acceso -----------------------------------------------------
#
# Los del login. Por direccion va holgado a proposito: la planta sale a
# internet por una sola IP y todo el turno comparte cuota. El estricto es el de
# usuario, que es el que sobrevive a un atacante que rota direcciones.
THROTTLE_LOGIN_IP=60/hour
THROTTLE_LOGIN_USUARIO=15/hour

# Cuantos proxies de confianza hay delante. **De esto depende que el limite por
# IP no sea esquivable**: sin declararlo, DRF usa la cabecera X-Forwarded-For
# entera como identidad y quien ataca estrena cubo mandando una distinta cada
# vez. Detras de Nginx: 1. Sin proxy: 0.
PROXIES_DE_CONFIANZA=1

# Cache compartida. **De ella dependen los limites de arriba**: se cuentan ahi,
# y una cache local a cada worker los convierte en «N por hora y por worker».
# Vacio usa la base de datos, que ya esta y es compartida.
# CACHE_URL=redis://redis:6379/1


# --- Cola de tareas --------------------------------------------------------
#
# Saca el MRP semanal de la peticion HTTP. **Vacio no rompe nada**: la tarea se
# ejecuta en el momento, dentro de la peticion, igual que antes. Es lo que
# permite desplegar esto antes de que llegue la fase de Redis.
#
# Con worker: celery -A config worker --loglevel=info --concurrency=2
# CELERY_BROKER_URL=redis://redis:6379/0

# Una tarea que no termina en veinte minutos es una tarea rota; sin techo, un
# calculo colgado retiene un worker para siempre.
CELERY_TASK_TIME_LIMIT=1200

# Ventana por defecto del panel general, en dias. Es un indicador de gestion,
# no el historico: para eso estan los listados, que paginan.
RESUMEN_DIAS=90

# Politica de sesion unica. Cero desactiva el limite correspondiente; la
# actividad solo se persiste al superar el intervalo para no escribir en cada
# request.
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_ACTIVITY_UPDATE_SECONDS=120
