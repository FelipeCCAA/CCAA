# Configuracion local. Copiar a backend/.env y ajustar.
#
# .env NO se versiona: cada equipo tiene el suyo. Este archivo es la lista de
# variables que el proyecto lee, con valores de ejemplo listos para produccion.
# Para desarrollo, lo habitual es dejar DJANGO_DEBUG=true y no tocar el resto.


# --- Django ----------------------------------------------------------------

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.tudominio.cl
CORS_ALLOWED_ORIGINS=https://app.tudominio.cl
CSRF_TRUSTED_ORIGINS=https://app.tudominio.cl
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=false


# --- Base de datos ---------------------------------------------------------
#
# El proyecto corre sobre PostgreSQL. El motivo esta en DECISIONES.md; el
# corto es que en SQLite solo escribe uno a la vez y el bloqueo de filas no
# existe, asi que la firma de una liberacion no se puede proteger de una
# modificacion concurrente.

# En Vercel + Neon basta con DATABASE_URL; la integracion la crea de forma
# automatica. En otros proveedores puedes copiar aqui su URL de conexion.
# DATABASE_URL=postgresql://usuario:clave@servidor/ccaa?sslmode=require

# Alternativa: variables separadas para instalaciones sin DATABASE_URL.
DB_NAME=ccaa
DB_USER=ccaa
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

# Salida para trabajar sin un PostgreSQL levantado. Descomentar solo para eso.
# No es equivalente: al arrancar avisa de lo que se pierde, y sin ponerla a
# mano se niega a arrancar con DEBUG=False. No usar para operar.
#
# DB_ENGINE=sqlite


# --- Recuperacion de contrasena --------------------------------------------

PASSWORD_RESET_FRONTEND_URL=https://app.tudominio.cl/#/restablecer-contrasena
PASSWORD_RESET_TIMEOUT=3600
DEFAULT_FROM_EMAIL=sistema-produccion@tudominio.cl


# --- Envio de correo por Microsoft Graph ------------------------------------
#
# Sin almacenar la contrasena personal de nadie: se registra una aplicacion en
# Entra con permiso Mail.Send de aplicacion. Conviene restringirla al buzon
# remitente con RBAC de Exchange, porque ese permiso alcanza a toda la
# organizacion si no se limita. El detalle esta en el README.

EMAIL_BACKEND=usuarios.email_backends.MicrosoftGraphEmailBackend
MICROSOFT_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_SECRET=reemplazar-en-el-entorno-seguro
MICROSOFT_GRAPH_SENDER=sistema-produccion@tudominio.cl
MICROSOFT_GRAPH_TIMEOUT=15
MICROSOFT_GRAPH_SAVE_TO_SENT_ITEMS=false
