{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "config.wsgi:application"
    }
  },
  "rewrites": [
    {
      "source": "/admin(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/static(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/login",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/recuperar-contrasena",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/restablecer-contrasena",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/dashboard",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/abastecimiento",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/procesos",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/mantenimiento",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/produccion",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/recepcion",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/liberacion",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/planificacion",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/maestros",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/registros",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/auditoria",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/administracion",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/inventario",
      "destination": { "type": "service", "service": "frontend", "path": "/index.html" }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
