# Copiar a .env en la raíz. No versionar el archivo resultante.
POSTGRES_DB=ccaa
POSTGRES_USER=ccaa
POSTGRES_PASSWORD=cambiar-por-un-secreto-largo
# La empresa a la que quedan asignados TODOS los datos que ya
# existen. Se crean una sola vez, al aplicar usuarios.0008, y el RUT es unico:
# cambiarlo despues no reasigna nada. Ponga los valores reales antes del primer
# despliegue.
CCAA_INITIAL_COMPANY_RUT=RUT-REAL-DE-LA-EMPRESA
CCAA_INITIAL_COMPANY_NAME=Campos Australes

# --- Defensas del acceso ---------------------------------------------------
#
# Cuantos proxies de confianza hay delante. **Obligatoria.** Con Nginx delante
# y sin ella, el limite por IP se esquiva mandando una cabecera
# X-Forwarded-For distinta en cada peticion: existiria sin frenar nada.
#   1 = detras del Nginx del compose
#   0 = solo si Django atiende directo, sin proxy
PROXIES_DE_CONFIANZA=1

# Por direccion va holgado a proposito: la planta sale a internet por una sola
# IP y todo el turno comparte cuota, asi que apretarlo aqui deja fuera al turno
# entero por culpa de un atacante. El estricto es el de usuario, que es el que
# sobrevive a quien rota direcciones.
THROTTLE_LOGIN_IP=60/hour
THROTTLE_LOGIN_USUARIO=15/hour

# Una sola sesión por usuario: inactividad, duración total y frecuencia
# máxima de escritura de la última actividad.
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_ACTIVITY_UPDATE_SECONDS=120

# Ventana por defecto del panel general, en dias.
RESUMEN_DIAS=90

# Cache y broker estan separados para que una rafaga de cache nunca expulse ni
# impida encolar tareas. Ambos usan AOF para conservar tareas y throttles.
CACHE_URL=redis://redis-cache:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=1200

# Valores cómodos para desarrollo local en http://localhost:8080.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=desarrollo-no-usar-en-produccion-cambiar-esta-clave-1234567890
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_HEALTHCHECK_HOST=localhost
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CCAA_HTTP_PORT=8080

# Una sola imagen sirve backend, migrate, Celery y Beat.
CCAA_BACKEND_IMAGE=ccaa-backend:local

# Base para el VPS objetivo de 4 vCPU / 4 GiB: 6 requests web simultaneas y
# una sola tarea pesada. Validar con carga real antes de subir concurrencia.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=35
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_WORKER_TMP_DIR=/dev/shm
# Vacio evita duplicar el access log estructurado que ya emite Nginx.
GUNICORN_ACCESS_LOG=
# Recicla workers gradualmente para contener crecimiento de memoria sin cortar
# todas las conexiones al mismo tiempo.
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
DB_CONN_MAX_AGE=60

# PostgreSQL OLTP. work_mem se aplica por operacion, no por servidor: no subirlo
# sin observar EXPLAIN y memoria bajo concurrencia.
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_SHM_SIZE=256m

# Broker y cache tienen AOF y noeviction; sus limites dejan margen para el pico
# de memoria copy-on-write de una reescritura AOF.
REDIS_BROKER_MAXMEMORY=64mb
REDIS_BROKER_MAXCLIENTS=100
REDIS_CACHE_MAXMEMORY=96mb
REDIS_CACHE_MAXCLIENTS=100

# Celery no compite con los requests por mas de un nucleo/proceso.
CELERY_CONCURRENCY=1
CELERY_PREFETCH_MULTIPLIER=1
CELERY_MAX_TASKS_PER_CHILD=50

# Techos de memoria. Total estable: 3.264 MiB; quedan ~832 MiB nominales para
# Ubuntu, Docker y cache de pagina. migrate usa 512 MiB solo antes del arranque.
POSTGRES_MEMORY_LIMIT=1024m
BACKEND_MEMORY_LIMIT=896m
CELERY_MEMORY_LIMIT=640m
CELERY_BEAT_MEMORY_LIMIT=192m
REDIS_BROKER_MEMORY_LIMIT=160m
REDIS_CACHE_MEMORY_LIMIT=224m
NGINX_MEMORY_LIMIT=128m
MIGRATE_MEMORY_LIMIT=512m

# Producción usa además compose.production.yml y certificados externos al repo:
# CCAA_TLS_DIR=/etc/letsencrypt/live/ccaa.tudominio.cl
