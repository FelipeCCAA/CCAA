# Copiar a .env en la raíz. No versionar el archivo resultante.
POSTGRES_DB=ccaa
POSTGRES_USER=ccaa
POSTGRES_PASSWORD=cambiar-por-un-secreto-largo

# Valores cómodos para desarrollo local en http://localhost:8080.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=desarrollo-no-usar-en-produccion-cambiar-esta-clave-1234567890
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_HEALTHCHECK_HOST=localhost
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CCAA_HTTP_PORT=8080

# Estos valores son una base conservadora, no un dimensionamiento final.
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
DB_CONN_MAX_AGE=60

# Producción usa además compose.production.yml y certificados externos al repo:
# CCAA_TLS_DIR=/etc/letsencrypt/live/ccaa.tudominio.cl
